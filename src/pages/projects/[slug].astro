---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/ui/Button.astro';

export const getStaticPaths = (async () => {
  const all = (await getCollection('projects')).sort((a, b) => a.id.localeCompare(b.id));
  return all.map((entry, i) => ({
    params: { slug: entry.data.slug },
    props: {
      entry,
      index: i,
      prev: all[(i - 1 + all.length) % all.length],
      next: all[(i + 1) % all.length],
    },
  }));
}) satisfies GetStaticPaths;

const { entry, index, prev, next } = Astro.props;
const { data } = entry;

const shortName = (title: string) => title.split(' — ')[0];
const name = shortName(data.title);
const isInk = data.category === 'Creative Design';
const hasLinks = !!(data.liveUrl || data.githubUrl);
---

<BaseLayout title={data.title} description={data.description}>
  <div class="hero-wrap">
    <section class="page-intro" aria-labelledby="project-title">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href="/#projects">Projects</a></li>
          <li><span aria-current="page">{name}</span></li>
        </ol>
      </nav>

      <p class="kicker">Project {String(index + 1).padStart(2, '0')} · {data.category} · {data.year}</p>
      <h1 id="project-title" class="page-title" lang="en">{data.title}</h1>
      <p class="page-lead">{data.description}</p>
    </section>
  </div>

  <section class="content detail-section">
    {
      data.isDummy && (
        <p class="dummy-note" role="note">
          <strong>Project contoh (placeholder).</strong> Konten pada halaman ini adalah data uji dan bukan hasil kerja nyata.
        </p>
      )
    }

    <!-- Hero screenshot: satu-satunya gambar LCP halaman ini -->
    {
      data.thumbnail ? (
        <figure class="detail-hero">
          <Image
            src={data.thumbnail}
            alt={data.thumbnailAlt ?? `Tampilan project ${name}`}
            widths={[800, 1400]}
            sizes="(max-width: 960px) 100vw, 60rem"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      ) : (
        <div class:list={['detail-hero', 'detail-hero--mock', { 'is-ink': isInk }]} aria-hidden="true">
          {isInk ? (
            <div class="mock-type">
              <span class="mock-type-name">{name.toUpperCase()}</span>
              <span class="mock-type-sub">Identity &amp; Type</span>
            </div>
          ) : (
            <div class="mock-window">
              <div class="mock-bar" />
              <div class="mock-line" />
              <div class="mock-line mock-line--short" />
              <div class="mock-blocks"><i /><i /><i /></div>
            </div>
          )}
        </div>
      )
    }

    <div class="detail-grid">
      <div class="detail-main">
        <section class="detail-card glass" aria-labelledby="h-overview">
          <h2 id="h-overview">Ringkasan</h2>
          <p>{data.overview}</p>
        </section>

        <section class="detail-card glass" aria-labelledby="h-challenge">
          <h2 id="h-challenge">Tantangan &amp; Tujuan</h2>
          <p>{data.challenge}</p>
        </section>

        <section class="detail-card glass" aria-labelledby="h-solution">
          <h2 id="h-solution">Solusi &amp; Pendekatan</h2>
          <p>{data.solution}</p>
        </section>

        <section class="detail-card glass" aria-labelledby="h-features">
          <h2 id="h-features">Fitur Utama</h2>
          <ul class="feature-list">
            {data.features.map((f) => <li>{f}</li>)}
          </ul>
        </section>
      </div>

      <aside class="detail-aside glass" aria-labelledby="h-info">
        <h2 id="h-info" class="visually-hidden">Informasi project</h2>

        <dl class="meta-list">
          <div>
            <dt>Kategori</dt>
            <dd>{data.category}</dd>
          </div>
          <div>
            <dt>Tahun</dt>
            <dd>{data.year}</dd>
          </div>
        </dl>

        <h3 class="aside-label">Technology Stack</h3>
        <ul class="tech-list" role="list">
          {data.technologies.map((t) => <li class="tech-pill">{t}</li>)}
        </ul>

        {
          hasLinks && (
            <div class="aside-actions">
              {data.liveUrl && (
                <Button href={data.liveUrl}>
                  Buka Live Website <span class="visually-hidden">{name}</span> <span aria-hidden="true">↗</span>
                </Button>
              )}
              {data.githubUrl && (
                <Button variant="glass" href={data.githubUrl}>
                  Source Code <span class="visually-hidden">{name}</span> <span aria-hidden="true">↗</span>
                </Button>
              )}
            </div>
          )
        }
      </aside>
    </div>

    {
      data.gallery.length > 0 && (
        <section class="gallery" aria-labelledby="h-gallery">
          <h2 id="h-gallery" class="gallery-title">Galeri Screenshot</h2>
          <ul class="gallery-grid" role="list">
            {data.gallery.map((g) => (
              <li>
                <figure>
                  <Image src={g.image} alt={g.alt} widths={[480, 900]} sizes="(max-width: 820px) 100vw, 45vw" loading="lazy" />
                </figure>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <nav class="pager" aria-label="Project lainnya">
      <a class="pager-link" href={`/projects/${prev.data.slug}`} rel="prev">
        <span class="pager-dir"><span aria-hidden="true">←</span> Sebelumnya</span>
        <span class="pager-name">{shortName(prev.data.title)}</span>
      </a>
      <a class="pager-link pager-link--next" href={`/projects/${next.data.slug}`} rel="next">
        <span class="pager-dir">Berikutnya <span aria-hidden="true">→</span></span>
        <span class="pager-name">{shortName(next.data.title)}</span>
      </a>
    </nav>
  </section>
</BaseLayout>

<style>
  /* ---------- Breadcrumb ---------- */
  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1.25rem;
    padding: 0;
    list-style: none;
    font-size: 0.85rem;
    font-weight: 600;
    color: #444;
  }
  .breadcrumb li + li::before {
    content: '/';
    margin-inline-end: 0.5rem;
    color: var(--color-muted);
  }
  .breadcrumb a {
    display: inline-block;
    padding-block: 0.25rem;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .breadcrumb a:hover { color: var(--color-crimson-text); }
  .breadcrumb [aria-current='page'] { color: var(--color-ink); font-weight: 700; }

  .detail-section { padding: 1rem 8% 4rem; }
  @media (max-width: 820px) {
    .detail-section { padding: 0.5rem 1.25rem 3rem; }
  }

  .dummy-note {
    margin: 0 0 1.5rem;
    padding: 0.75rem 1rem;
    border-radius: 0.875rem;
    background: rgba(255, 255, 255, 0.8);
    border: 1px dashed var(--color-crimson-text);
    font-size: 0.85rem;
    color: #444;
  }
  .dummy-note strong { color: var(--color-crimson-text); }

  /* ---------- Hero ---------- */
  .detail-hero {
    margin: 0 0 1.5rem;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: 1.5rem;
    border: 1px solid var(--color-glass-border);
    box-shadow: 0 20px 50px rgba(31, 26, 23, 0.14), 0 0 0 1px var(--color-glass-edge);
  }
  .detail-hero :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
  .detail-hero--mock {
    display: grid;
    place-items: center;
    background: #f6d8da;
  }
  .detail-hero--mock.is-ink { background: #222026; }

  .mock-window {
    inline-size: min(34rem, 80%);
    padding: 1.25rem;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.88);
    border: 1px solid #fff;
    box-shadow: 0 18px 44px rgba(31, 26, 23, 0.18);
    rotate: -2deg;
  }
  .mock-bar { inline-size: 30%; block-size: 10px; margin-block-end: 1rem; border-radius: 6px; background: rgba(217, 45, 58, 0.45); }
  .mock-line { inline-size: 75%; block-size: 11px; margin: 0.6rem 0; border-radius: 6px; background: rgba(31, 26, 23, 0.14); }
  .mock-line--short { inline-size: 45%; }
  .mock-blocks { display: flex; gap: 0.75rem; margin-block-start: 1.25rem; }
  .mock-blocks :global(i) { display: block; flex: 1; block-size: 5.5rem; border-radius: 8px; background: rgba(217, 45, 58, 0.14); }

  .mock-type { text-align: center; }
  .mock-type-name {
    display: block;
    font: 800 clamp(2rem, 1.2rem + 4vw, 4rem) var(--font-display);
    letter-spacing: -0.04em;
    color: var(--color-coral); /* teks besar */
  }
  .mock-type-sub {
    display: block;
    margin-block-start: 0.5rem;
    font-size: 1rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fff;
  }

  /* ---------- Grid konten ---------- */
  .detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    align-items: start;
    gap: 1.5rem;
  }
  .detail-main { display: grid; gap: 1.25rem; }

  .detail-card {
    padding: 1.5rem 1.75rem;
    border-radius: 1.375rem;
  }
  .detail-card h2 {
    margin: 0 0 0.5rem;
    font: 800 1.2rem/1.3 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .detail-card p {
    max-inline-size: 62ch;
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.75;
    color: #444;
  }
  .feature-list {
    display: grid;
    gap: 0.5rem;
    max-inline-size: 62ch;
    margin: 0;
    padding-inline-start: 1.2rem;
    font-size: 0.95rem;
    line-height: 1.65;
    color: #444;
  }
  .feature-list li::marker { color: var(--color-crimson-text); }

  .detail-aside {
    position: sticky;
    top: calc(var(--header-offset) + 1rem);
    padding: 1.5rem;
    border-radius: 1.375rem;
  }
  .meta-list { display: grid; gap: 0.75rem; margin: 0 0 1.25rem; }
  .meta-list dt {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .meta-list dd { margin: 0.1rem 0 0; font-weight: 700; color: var(--color-ink); }
  .aside-label {
    margin: 0 0 0.5rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-crimson-text);
  }
  .aside-actions {
    display: grid;
    gap: 0.625rem;
    margin-block-start: 1.5rem;
    padding-block-start: 1.25rem;
    border-top: 1px solid rgba(31, 26, 23, 0.1);
  }

  /* ---------- Galeri ---------- */
  .gallery { margin-block-start: 2.5rem; }
  .gallery-title {
    margin: 0 0 1rem;
    font: 800 1.4rem/1.3 var(--font-display);
    letter-spacing: -0.02em;
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .gallery-grid figure { margin: 0; overflow: hidden; border-radius: 1rem; border: 1px solid var(--color-glass-border); box-shadow: 0 8px 24px rgba(31, 26, 23, 0.08); }
  .gallery-grid :global(img) { display: block; inline-size: 100%; block-size: auto; }

  /* ---------- Previous / Next ---------- */
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-block-start: 3rem;
  }
  .pager-link {
    display: grid;
    gap: 0.2rem;
    padding: 1.1rem 1.4rem;
    border-radius: 1.25rem;
    background: var(--color-glass);
    -webkit-backdrop-filter: var(--blur);
    backdrop-filter: var(--blur);
    border: 1px solid var(--color-glass-border);
    box-shadow: 0 8px 24px rgba(31, 26, 23, 0.05), 0 0 0 1px var(--color-glass-edge), inset 0 1px 0 #fff;
    transition: box-shadow 0.25s ease, translate 0.25s ease;
  }
  .pager-link--next { text-align: end; }
  .pager-link:hover { box-shadow: 0 14px 34px rgba(31, 26, 23, 0.12), 0 0 0 1px rgba(31, 26, 23, 0.2), inset 0 1px 0 #fff; }
  @media (prefers-reduced-motion: no-preference) {
    .pager-link:hover { translate: 0 -3px; }
  }
  .pager-dir { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-crimson-text); }
  .pager-name { font: 800 1.1rem/1.3 var(--font-display); color: var(--color-ink); }

  @media (max-width: 960px) {
    .detail-grid { grid-template-columns: 1fr; }
    .detail-aside { position: static; }
  }
  @media (max-width: 560px) {
    .gallery-grid,
    .pager { grid-template-columns: 1fr; }
    .pager-link--next { text-align: start; }
    .detail-card { padding: 1.25rem; }
  }

  @media (forced-colors: active) {
    .detail-hero,
    .pager-link,
    .gallery-grid figure { border: 1px solid CanvasText; box-shadow: none; }
    .dummy-note { border-color: CanvasText; }
  }
</style>