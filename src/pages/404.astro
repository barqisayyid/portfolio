---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="Halaman tidak ditemukan" description="Halaman yang Anda cari tidak tersedia." noindex>
  <div class="hero-wrap not-found-wrap">
    <section class="page-intro not-found" aria-labelledby="nf-title">
      <p class="nf-code" aria-hidden="true">404</p>
      <h1 id="nf-title" class="page-title">Halaman <em>tidak ditemukan.</em></h1>
      <p class="page-lead">
        Tautan yang Anda buka mungkin salah ketik atau halamannya sudah dipindahkan. Kembali ke beranda atau lihat project pilihan saya.
      </p>
      <div class="nf-actions">
        <Button href="/">Kembali ke Beranda</Button>
        <Button variant="glass" href="/#projects">Lihat Project <span aria-hidden="true">↗</span></Button>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .not-found-wrap { min-block-size: 80dvh; display: grid; align-items: center; }
  .not-found { text-align: center; }
  .not-found .page-title,
  .not-found .page-lead { margin-inline: auto; }
  .nf-code {
    margin: 0;
    font: 800 clamp(5rem, 3rem + 10vw, 9rem) / 1 var(--font-display);
    letter-spacing: -0.06em;
    color: var(--color-crimson); /* teks besar */
    text-shadow: 0 10px 40px rgba(217, 45, 58, 0.35);
  }
  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-block-start: 1.75rem;
  }
</style>