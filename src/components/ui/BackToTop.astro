<a href="#top" class="back-to-top" id="backToTop" aria-label="Kembali ke atas halaman">
  <span aria-hidden="true">↑</span>
  <span>Atas</span>
</a>

<style>
  .back-to-top {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 35;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-inline-size: 2.85rem;
    min-block-size: 2.85rem;
    padding: 0 1rem;
    border-radius: 999px;
    background: var(--color-glass-strong);
    -webkit-backdrop-filter: var(--blur);
    backdrop-filter: var(--blur);
    border: 1px solid var(--color-glass-border);
    box-shadow: 0 10px 28px rgba(31, 26, 23, 0.16), 0 0 0 1px var(--color-glass-edge);
    color: var(--color-ink);
    font-size: 0.8rem;
    font-weight: 700;
    visibility: hidden;
    opacity: 0;
    translate: 0 12px;
    transition:
      visibility 0.25s ease,
      opacity 0.25s ease,
      translate 0.25s ease,
      background-color 0.2s ease,
      color 0.2s ease;
  }
  .back-to-top:hover {
    background: var(--color-crimson);
    color: #fff;
  }

  /* Native: tampil bila halaman sudah di-scroll ke bawah */
  @supports (container-type: scroll-state) {
    @container page-scroll scroll-state(scrollable: top) {
      .back-to-top {
        visibility: visible;
        opacity: 1;
        translate: 0 0;
      }
    }
  }
  /* Fallback (kelas diatur oleh skrip Navbar) */
  :global(body.is-scrolled) .back-to-top {
    visibility: visible;
    opacity: 1;
    translate: 0 0;
  }

  @media (forced-colors: active) {
    .back-to-top { border: 1px solid CanvasText; box-shadow: none; }
  }
</style>

<script>
  // Jika tombol menghilang saat sedang fokus, pindahkan fokus ke konten utama
  document.getElementById('backToTop')?.addEventListener('focusout', (e) => {
    if (!e.relatedTarget && window.scrollY < 24) {
      document.getElementById('main-content')?.focus();
    }
  });
</script>