---
interface Props {
  as?: keyof HTMLElementTagNameMap;
  strong?: boolean;
  class?: string;
  [key: string]: unknown;
}
const { as: Tag = 'div', strong = false, class: className, ...rest } = Astro.props;
---

<Tag class:list={['glass-card glass', { 'glass-strong': strong }, className]} {...rest}>
  <slot />
</Tag>

<style>
  .glass-card {
    border-radius: 1.25rem;
    padding: 1.5rem;
  }
</style>