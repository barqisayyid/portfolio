---
import { getCollection } from 'astro:content';
import Button from '../ui/Button.astro';

const experiences = (await getCollection('experiences')).sort((a, b) =>
  b.data.startDate.localeCompare(a.data.startDate),
);

const period = (d: (typeof experiences)[number]['data']) =>
  `${d.startDate} — ${d.isCurrent ? 'Sekarang' : (d.endDate ?? '')}`;
---

<section class="content deferred-section" id="experience" tabindex="-1" aria-labelledby="experience-heading">
  <div class="section-head">
    <div>
      <div class="kicker" lang="en">Career Journey</div>
      <h2 id="experience-heading" class="section-title" lang="en">Work <em>Experience</em></h2>
    </div>
    <p class="section-intro">
      Rekam jejak profesional dalam merancang dan mengembangkan antarmuka website serta identitas visual brand.
    </p>
  </div>

  <ol class="experience-list" role="list">
    {
      experiences.map(({ data }) => (
        <li class="experience-card reveal-item">
          <div class="exp-period">{period(data)}</div>
          <div class="exp-role">
            <h3>{data.position}</h3>
            <p class="company">{data.organization} · {data.location}</p>
            <p class="summary">{data.summary}</p>
          </div>
          <span class="exp-badge">{data.employmentType}</span>
        </li>
      ))
    }
  </ol>

  <div class="experience-cta">
    <Button variant="glass" href="/experience">
      Lihat Riwayat Lengkap <span aria-hidden="true">→</span>
    </Button>
  </div>
</section>

<style>
  .experience-list {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .experience-card {
    display: grid;
    grid-template-columns: 13.75rem 1fr auto;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem 1.75rem;
    border-radius: 1.125rem;
    background: var(--color-glass);
    -webkit-backdrop-filter: var(--blur);
    backdrop-filter: var(--blur);
    border: 1px solid var(--color-glass-border);
    box-shadow: 0 8px 24px rgba(31, 26, 23, 0.05), 0 0 0 1px var(--color-glass-edge), inset 0 1px 0 #fff;
    transition: box-shadow 0.25s ease, translate 0.25s ease;
  }
  .experience-card:hover {
    box-shadow: 0 12px 32px rgba(31, 26, 23, 0.1), 0 0 0 1px rgba(31, 26, 23, 0.18), inset 0 1px 0 #fff;
  }
  @media (prefers-reduced-motion: no-preference) {
    .experience-card:hover { translate: 4px 0; }
  }

  .exp-period {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-crimson-text);
  }
  .exp-role h3 {
    margin: 0 0 0.15rem;
    font: 700 1.125rem/1.3 var(--font-display);
    color: var(--color-ink);
  }
  .company {
    margin: 0 0 0.375rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #444;
  }
  .summary {
    margin: 0;
    max-inline-size: 38.75rem;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-muted);
  }
  .exp-badge {
    justify-self: start;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    background: rgba(217, 45, 58, 0.12);
    border: 1px solid rgba(217, 45, 58, 0.3);
    color: #8e1823;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .experience-cta {
    display: flex;
    justify-content: flex-end;
    margin-block-start: 1.5rem;
  }

  @media (max-width: 960px) {
    .experience-card { grid-template-columns: 1fr; gap: 0.75rem; }
  }
  @media (max-width: 820px) {
    .experience-cta { justify-content: flex-start; }
  }
  @media (forced-colors: active) {
    .experience-card,
    .exp-badge { border: 1px solid CanvasText; box-shadow: none; }
  }
</style>