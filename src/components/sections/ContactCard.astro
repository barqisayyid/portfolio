---
import Button from '../ui/Button.astro';
import CopyEmailButton from '../ui/CopyEmailButton.astro';
import { site } from '../../data/site';

const links = [
  { label: 'LinkedIn', href: site.socials.linkedin },
  { label: 'GitHub', href: site.socials.github },
  { label: 'WhatsApp', href: site.whatsapp },
];
---

<section class="contact deferred-section" id="contact" tabindex="-1" aria-labelledby="contact-heading">
  <div class="contact-copy">
    <div class="kicker" lang="en">Have a project in mind?</div>
    <h2 id="contact-heading" lang="en">Let's make something <em>meaningful.</em></h2>
    <p>Terbuka untuk peluang kerja sama, project pengembangan website, maupun konsultasi desain antarmuka digital.</p>
  </div>

  <div class="contact-actions">
    <CopyEmailButton email={site.email} />

    <div class="contact-links">
      <Button href={`mailto:${site.email}`}>Kirim Email <span aria-hidden="true">↗</span></Button>
      {
        links.map((l) => (
          <a class="social-pill" href={l.href} target="_blank" rel="noopener noreferrer">
            {l.label} <span aria-hidden="true">↗</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .contact {
    position: relative;
    overflow: clip;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.25rem;
    padding: 4.75rem 8%;
    color: var(--color-text);
    contain-intrinsic-size: auto 24rem; /* menimpa nilai default .deferred-section */
    background:
      radial-gradient(480px 360px at 10% 20%, rgba(255, 90, 102, 0.38), transparent 70%),
      radial-gradient(500px 400px at 92% 90%, rgba(217, 45, 58, 0.22), transparent 70%),
      #f1ebe7;
  }

  .contact h2 {
    max-inline-size: 37.5rem;
    margin: 0.5rem 0;
    font-family: var(--font-display);
    font-weight: 800;
    /* max/min = 3.25 / 2 = 1.63 (<= 2.5) */
    font-size: clamp(2rem, 1.35rem + 3vw, 3.25rem);
    line-height: 1.15;
    letter-spacing: -0.035em;
    color: var(--color-ink);
  }
  .contact h2 em { font-style: italic; color: var(--color-crimson); }
  .contact-copy p {
    max-inline-size: 32rem;
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-muted);
  }

  .contact-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
  }
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.625rem;
  }

  .social-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-block-size: 2.75rem;
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.76);
    border: 1px solid var(--color-glass-edge);
    color: var(--color-ink);
    font-size: 0.8rem;
    font-weight: 700;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .social-pill:hover { background: #fff; color: var(--color-crimson-text); }

  @media (max-width: 820px) {
    .contact { flex-direction: column; align-items: flex-start; padding: 3.5rem 1.25rem; }
    .contact-actions { align-items: flex-start; inline-size: 100%; }
    .contact-links { justify-content: flex-start; }
    /* CopyEmailButton punya style sendiri (scoped), jadi pakai :global */
    .contact-actions :global(.copy-email) { align-items: flex-start; inline-size: 100%; }
  }

  @media (forced-colors: active) {
    .social-pill { border: 1px solid ButtonText; }
  }
</style>