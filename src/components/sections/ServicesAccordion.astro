---
const services = [
  {
    no: '01.',
    title: 'Graphic & Visual Design',
    tags: ['Poster & Flyer', 'Brand Identity', 'Infographic', 'Editorial Book', 'Typography Specimen'],
    body: 'Mengolah ide dan pesan menjadi komunikasi visual yang berkarakter, berani, serta konsisten di media cetak maupun layar digital.',
    open: false,
  },
  {
    no: '02.',
    title: 'Web Development',
    tags: ['Astro', 'React', 'Tailwind CSS 4', 'TypeScript', 'Motion', 'Vercel SSG'],
    body: 'Membangun website statis berkecepatan tinggi dengan pendekatan Islands Architecture, Core Web Vitals optimal, dan aksesibilitas ramah pengguna.',
    open: true, // default terbuka
  },
  {
    no: '03.',
    title: 'UI/UX & Dashboard Design',
    tags: ['Wireframing', 'Interactive Prototype', 'Dashboard System', 'Design System'],
    body: 'Merancang antarmuka produk digital dengan hierarki visual teratur, alur pengguna yang intuitif, serta mikro-interaksi yang memikat.',
    open: false,
  },
  {
    no: '04.',
    title: 'Digital Experience & Institutional Systems',
    tags: ['Information System', 'Interactive Exhibition', 'Landing Page', 'Culture Archive'],
    body: 'Mendukung digitalisasi sistem informasi institusi dan eksplorasi kuratorial interaktif berbasis web modern.',
    open: false,
  },
];
---

<section class="content" id="services" tabindex="-1" aria-labelledby="services-heading">
  <div class="section-head">
    <div>
      <div class="kicker" lang="en">What I do</div>
      <h2 id="services-heading" class="section-title" lang="en"><em>Creative</em> Services</h2>
    </div>
    <p class="section-intro">
      Menggabungkan pemikiran desain dan kemampuan teknis untuk membangun karya visual serta pengalaman digital yang fungsional.
    </p>
  </div>

  <div class="services">
    {
      services.map((s) => (
        <details class="service reveal-item" open={s.open}>
          <summary>
            <span class="service-no">{s.no}</span>
            <span class="service-title" lang="en">{s.title}</span>
            <span class="service-icon" aria-hidden="true">↗</span>
          </summary>
          <div class="service-body">
            <ul class="tags" role="list">
              {s.tags.map((t) => <li>{t}</li>)}
            </ul>
            <p>{s.body}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .services { display: grid; gap: 0.75rem; }

  .service {
    interpolate-size: allow-keywords;
    overflow: hidden;
    border-radius: 1.25rem;
    background: var(--color-glass);
    -webkit-backdrop-filter: var(--blur);
    backdrop-filter: var(--blur);
    border: 1px solid var(--color-glass-border);
    box-shadow:
      0 10px 32px rgba(31, 26, 23, 0.06),
      0 0 0 1px var(--color-glass-edge),
      inset 0 1px 0 #fff;
    transition: background-color 0.25s ease, color 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .service:hover {
    box-shadow:
      0 14px 38px rgba(31, 26, 23, 0.12),
      0 0 0 1px rgba(31, 26, 23, 0.18),
      inset 0 1px 0 #fff;
  }

  .service summary {
    display: grid;
    grid-template-columns: 4rem 1fr 2.25rem;
    align-items: center;
    gap: 0.875rem;
    padding: 1.375rem 1.75rem;
    list-style: none;
    cursor: pointer;
    font: 700 1.125rem var(--font-display);
  }
  .service summary::-webkit-details-marker { display: none; }

  /* Outline di dalam kartu (kartu memakai overflow: hidden) */
  .service summary:focus-visible {
    outline-offset: -4px;
    border-radius: 1.25rem;
  }

  .service-no { font-size: 0.95rem; color: var(--color-muted); }

  .service-icon {
    display: grid;
    place-items: center;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(31, 26, 23, 0.1);
    font-size: 1rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    transition: rotate 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  /* ---------- State terbuka: crimson solid + teks putih murni ---------- */
  .service[open] {
    background: rgba(217, 45, 58, 0.94);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.5);
    box-shadow: 0 18px 44px rgba(217, 45, 58, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.4);
  }
  .service[open] .service-no { color: #fff; }
  .service[open] .service-icon {
    background: #fff;
    color: var(--color-crimson-text);
    rotate: 45deg; /* penanda non-warna: ikon berputar */
  }
  .service[open] summary:focus-visible { outline-color: #fff; }

  /* ---------- Animasi tinggi native (progressive enhancement, 0 KB JS) ---------- */
  .service::details-content {
    overflow: clip;
    contain: layout;
  }
  .service:not([open])::details-content { block-size: 0; }

  @media (prefers-reduced-motion: no-preference) {
    .service::details-content {
      transition-property: block-size, content-visibility;
      transition-duration: 0.3s;
      transition-timing-function: ease-in-out;
      transition-behavior: allow-discrete;
    }
  }

  .service-body {
    max-inline-size: 50rem;
    padding: 0 1.75rem 1.5625rem 6.625rem;
    color: #fff;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  /* Latar GELAP transparan (bukan putih) agar teks putih tetap >= 4.5:1 di atas crimson */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 0.875rem;
    padding: 0;
    list-style: none;
  }
  .tags li {
    padding: 0.32rem 0.72rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.55);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
  }

  @media (max-width: 820px) {
    .service summary {
      grid-template-columns: 2.5rem 1fr 2rem;
      padding: 1.125rem 1rem;
      font-size: 0.95rem;
    }
    .service-body { padding: 0 1rem 1.25rem 4rem; font-size: 0.85rem; }
  }

  @media (forced-colors: active) {
    .service { border: 1px solid CanvasText; box-shadow: none; }
    .service[open] { border: 2px solid Highlight; }
    .service-icon { border: 1px solid CanvasText; }
    .tags li { border: 1px solid CanvasText; }
  }
</style>