---
import { Picture } from 'astro:assets';
import portrait from '../../assets/images/profile/sayyid-barqi-cutout.webp';
import Button from '../ui/Button.astro';
import SocialIcon from '../ui/SocialIcon.astro';
import { site } from '../../data/site';

const skills = [
  { label: 'UI/UX Design', crimson: false },
  { label: 'Web Development', crimson: true },
  { label: 'Astro & React', crimson: false },
  { label: 'Graphic Design', crimson: true },
  { label: 'Tailwind CSS 4', crimson: false },
];

const socials = [
  { name: 'linkedin', label: 'LinkedIn', href: site.socials.linkedin },
  { name: 'github', label: 'GitHub', href: site.socials.github },
  { name: 'instagram', label: 'Instagram', href: site.socials.instagram },
] as const;
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="eyebrow" lang="en">Hello there!</div>
  <h1 id="hero-heading" lang="en">I'm <span>Sayyid Barqi</span>.</h1>
  <p class="hero-sub" lang="en">
    Creative Designer &amp; Web Developer — I build digital experiences through web development and visual design.
  </p>

  <!-- Availability Orbit Badge -->
  <a href="#contact" class="availability glass" lang="en" aria-label="Hire me — Open for projects">
    <span class="orbit-ring" aria-hidden="true"></span>
    <span class="orbit-label" aria-hidden="true">HIRE ME • HIRE ME</span>
    <span class="availability-arrow" aria-hidden="true">↗</span>
  </a>

  <div class="hero-stage">
    <!-- Piringan crimson + potret cutout -->
    <div class="hero-art">
      <div class="crimson-disc" aria-hidden="true"></div>
      <Picture
        src={portrait}
        alt="Foto Sayyid Barqi Almukarrom Ramadhan"
        class="portrait"
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[280, 420, 560, 760]}
        sizes="(max-width: 560px) 220px, (max-width: 820px) 280px, 380px"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>

    <aside class="side-note glass" aria-label="Filosofi desain" lang="en">
      <span class="quote" aria-hidden="true">“</span>
      <strong>Ideas into visuals.<br />Design into experiences.</strong><br />
      Building thoughtful digital work with creativity and purpose.
    </aside>

    <ul class="skill-cloud" role="list" aria-label="Keahlian inti">
      {skills.map((s) => <li class:list={['pill', { 'pill--crimson': s.crimson }]}>{s.label}</li>)}
    </ul>

    <div class="socials">
      <span class="socials-label" lang="en">Find me on</span>
      {
        socials.map((s) => (
          <a
            class="glass"
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${s.label} ${site.shortName}`}
          >
            <SocialIcon name={s.name} />
          </a>
        ))
      }
    </div>

    <div class="hero-actions glass">
      <Button href="#projects">Portfolio <span aria-hidden="true">↗</span></Button>
      <Button variant="glass" href="#contact" lang="en">Hire Me</Button>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 1;
    min-block-size: 44rem;
    padding: 3.75rem 7.5% 0;
    text-align: center;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #444;
  }
  .eyebrow::before {
    content: '';
    inline-size: 1.375rem;
    block-size: 2px;
    background: var(--color-coral);
  }

  /* clamp max/min = 4.375 / 2.25 = 1.94 (<= 2.5) */
  h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.25rem, 1.4rem + 3.8vw, 4.375rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
    margin: 0.875rem auto 0.625rem;
    color: var(--color-ink);
  }
  h1 span {
    color: var(--color-crimson); /* teks besar: aman >= 3:1 */
    font-style: italic;
  }

  .hero-sub {
    margin: 0 auto;
    max-inline-size: 39rem;
    font-size: 1rem;
    color: #474747;
  }

  /* ---------- Orbit badge ---------- */
  .availability {
    position: absolute;
    z-index: 3;
    right: 8%;
    top: 5.5rem;
    display: grid;
    place-items: center;
    inline-size: 5.875rem;
    block-size: 5.875rem;
    border-radius: 50%;
    rotate: 12deg;
    transition: rotate 0.3s ease, scale 0.3s ease;
  }
  .orbit-ring {
    position: absolute;
    inset: 0.5rem;
    border: 1px dashed rgba(31, 26, 23, 0.28);
    border-radius: 50%;
    pointer-events: none;
  }
  .orbit-label {
    position: absolute;
    inset-inline: 0;
    top: 0.82rem;
    text-align: center;
    white-space: nowrap;
    font-size: 0.48rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    color: var(--color-ink);
    pointer-events: none;
  }
  .availability-arrow {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    border-radius: 50%;
    background: var(--color-crimson);
    color: #fff;
    font-size: 1.125rem;
    box-shadow: 0 4px 12px rgba(217, 45, 58, 0.4);
  }

  /* Rotasi hanya bila pengguna tidak meminta gerak minimal; ikut berhenti saat dijeda */
  @media (prefers-reduced-motion: no-preference) {
    .availability:hover { rotate: 0deg; scale: 1.05; }
    .orbit-ring { animation: slow-orbit 18s linear infinite; }
    .availability:hover .orbit-ring,
    .availability:focus-visible .orbit-ring,
    :global(body.animations-paused) .orbit-ring { animation-play-state: paused; }
  }
  @keyframes slow-orbit {
    to { rotate: 360deg; }
  }

  /* ---------- Panggung ---------- */
  .hero-stage {
    position: relative;
    max-inline-size: 70rem;
    min-block-size: 31.25rem;
    margin: 0.625rem auto 0;
  }

  /* Wrapper potret + piringan. Ukuran diatur lewat 2 variabel. */
  .hero-art {
    --disc: 27.5rem;
    --portrait-h: 33.75rem;
    position: absolute;
    left: 50%;
    bottom: 0;
    translate: -50% 0;
    inline-size: var(--disc);
    block-size: var(--portrait-h);
  }
  .crimson-disc {
    position: absolute;
    left: 50%;
    bottom: 0;
    translate: -50% 0;
    inline-size: var(--disc);
    block-size: var(--disc);
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-crimson);
    box-shadow:
      0 30px 90px rgba(217, 45, 58, 0.45),
      0 0 0 14px rgba(255, 255, 255, 0.45),
      0 0 0 15px rgba(255, 255, 255, 0.85);
  }
  .crimson-disc::after {
    content: '';
    position: absolute;
    inset: 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 50%;
  }
  .hero-art :global(.portrait) {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: -3px;
    translate: -50% 0;
    block-size: var(--portrait-h);
    inline-size: auto;
    max-inline-size: 100%;
    object-fit: contain;
    object-position: center bottom;
    filter: drop-shadow(0 16px 26px rgba(31, 26, 23, 0.35));
  }

  /* ---------- Elemen melayang ---------- */
  .side-note {
    position: absolute;
    z-index: 3;
    left: 0;
    top: 7.75rem;
    inline-size: 15.25rem;
    padding: 1.125rem 1.25rem 1.25rem;
    border-radius: 1.25rem;
    text-align: start;
    font-size: 0.82rem;
    line-height: 1.55;
    color: #4a4a4a;
  }
  .side-note strong { color: var(--color-ink); font-weight: 700; }
  .quote {
    display: block;
    margin-block-end: 0.125rem;
    font: 700 2.25rem/1 Georgia, serif;
    color: var(--color-coral); /* dekoratif, besar */
  }

  .skill-cloud {
    position: absolute;
    z-index: 3;
    right: 0;
    top: 9rem;
    inline-size: 15.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .skill-cloud .pill { transition: translate 0.2s ease, box-shadow 0.2s ease; }
    .skill-cloud .pill:hover { translate: 0 -2px; box-shadow: 0 6px 18px rgba(31, 26, 23, 0.12); }
  }

  .socials {
    position: absolute;
    z-index: 3;
    right: 0.3rem;
    bottom: 3rem;
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .socials-label { font-size: 0.75rem; font-weight: 600; color: var(--color-muted); }
  .socials a {
    display: grid;
    place-items: center;
    min-inline-size: 2.75rem; /* >= 44px */
    min-block-size: 2.75rem;
    border-radius: 50%;
    color: var(--color-ink);
    transition: background-color 0.2s ease, color 0.2s ease, translate 0.2s ease;
  }
  .socials a:hover { background: #fff; color: var(--color-crimson-text); }
  @media (prefers-reduced-motion: no-preference) {
    .socials a:hover { translate: 0 -2px; }
  }

  .hero-actions {
    position: absolute;
    z-index: 4;
    left: 50%;
    bottom: 1rem;
    translate: -50% 0;
    display: flex;
    gap: 0.5rem;
    padding: 0.375rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    white-space: nowrap;
  }

  /* ---------- Tablet / mobile ---------- */
  @media (max-width: 820px) {
    .hero { padding: 3.5rem 1.25rem 0; min-block-size: 38rem; }
    .availability { inline-size: 3.5rem; block-size: 3.5rem; right: 5%; top: 1.5rem; }
    .orbit-ring { inset: 0.35rem; }
    .orbit-label { display: none; }
    .availability-arrow { inline-size: 1.75rem; block-size: 1.75rem; font-size: 0.95rem; }

    .hero-stage { min-block-size: 25.5rem; margin-block-start: 1.5rem; }
    .hero-art { --disc: 19rem; --portrait-h: 24.5rem; }

    .side-note { top: 0.5rem; inline-size: 9.25rem; padding: 0.75rem; border-radius: 1rem; font-size: 0.7rem; }
    .quote { font-size: 1.5rem; }
    .skill-cloud { top: 0.75rem; inline-size: 9.25rem; gap: 0.3rem; }
    .skill-cloud .pill { font-size: 0.65rem; padding: 0.4rem 0.625rem; }
    .socials { display: none; }
    .hero-actions { bottom: 0.625rem; }
  }

  /* Layar sangat sempit: susun vertikal agar kartu tidak menutupi wajah */
  @media (max-width: 560px) {
    .hero-stage {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      min-block-size: auto;
      padding-block-end: 4.5rem;
    }
    .hero-art {
      --disc: 16rem;
      --portrait-h: 20rem;
      position: relative;
      left: auto;
      bottom: auto;
      translate: none;
      margin-block-start: 1rem;
    }
    .side-note,
    .skill-cloud {
      position: static;
      inline-size: 100%;
    }
    .skill-cloud { justify-content: center; }
        .hero-actions {
      flex-wrap: wrap;
      justify-content: center;
      max-inline-size: calc(100% - 1rem);
      white-space: normal;
    }
  }


    /* ---------- Animasi masuk (opt-in, hanya compositor: opacity & transform) ---------- */
  @media (prefers-reduced-motion: no-preference) {
    @keyframes hero-rise {
      from { opacity: 0.01; transform: translateY(14px); }
      to   { opacity: 1;    transform: none; }
    }
    /* Potret TANPA opacity agar LCP tidak tertunda */
    @keyframes portrait-rise {
      from { transform: translateY(18px) scale(0.97); }
      to   { transform: none; }
    }

    .eyebrow,
    h1,
    .hero-sub,
    .side-note,
    .skill-cloud,
    .availability,
    .socials,
    .hero-actions {
      animation: hero-rise 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .eyebrow      { animation-delay: 0ms; }
    h1            { animation-delay: 80ms; }
    .hero-sub     { animation-delay: 160ms; }
    .side-note    { animation-delay: 240ms; }
    .skill-cloud  { animation-delay: 300ms; }
    .availability { animation-delay: 340ms; }
    .socials      { animation-delay: 380ms; }
    .hero-actions { animation-delay: 420ms; }

    .hero-art :global(.portrait) {
      animation: portrait-rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) 100ms both;
    }
  }


  @media (forced-colors: active) {
    .crimson-disc { border: 2px solid CanvasText; }
    .availability-arrow { border: 2px solid CanvasText; }
    .orbit-ring { border-color: CanvasText; }
  }
</style>