---
import { site } from '../../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <span>&copy; <span id="yearVal">{year}</span> {site.name}. All rights reserved.</span>
  <span lang="en">Designed with intention · Built with curiosity.</span>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.75rem 8% 4.5rem; /* ruang bawah agar tidak tertutup tombol Back to Top */
    background: var(--color-paper);
    border-top: 1px solid rgba(31, 26, 23, 0.1);
    color: var(--color-muted);
    font-size: 0.8rem;
  }
  @media (max-width: 820px) {
    .site-footer {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.5rem 1.25rem 5rem;
    }
  }
</style>

<script>
  // Tahun hak cipta tetap benar walau situs statis dibangun beberapa tahun lalu
  const el = document.getElementById('yearVal');
  if (el) el.textContent = String(new Date().getFullYear());
</script>